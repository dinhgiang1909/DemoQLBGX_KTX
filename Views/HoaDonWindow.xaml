<ui:FluentWindow x:Class="QLBGX.Views.HoaDonWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Hóa đơn" Width="440" Height="760"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True">
    <Window.Resources>
        <Style x:Key="Nhan" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="GiaTri" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Hóa đơn" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border x:Name="Phieu" Background="White" Margin="16,0,16,8" Padding="24" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel TextElement.Foreground="Black">
                    <TextBlock Text="BÃI GIỮ XE KÝ TÚC XÁ" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
                    <TextBlock Text="HÓA ĐƠN THU TIỀN" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <TextBlock HorizontalAlignment="Center" Margin="0,2,0,12">
                        <Run Text="{Binding LoaiHoaDon, Mode=OneWay}" />
                        <Run Text=" – Số:" />
                        <Run Text="{Binding MaHoaDon, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource Nhan}" Text="Ngày giờ" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource GiaTri}" Text="{Binding NgayTao, StringFormat=dd/MM/yyyy HH:mm:ss}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource Nhan}" Text="Biển số" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource GiaTri}" FontWeight="Bold" Text="{Binding BienSo}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource Nhan}" Text="Loại xe" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource GiaTri}" Text="{Binding TenLoaiXe}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource Nhan}" Text="Mã thẻ" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource GiaTri}" Text="{Binding MaThe}" />
                        <TextBlock Grid.Row="4" Style="{StaticResource Nhan}" Text="Khách hàng"
                                   Visibility="{Binding TenKhachHang, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource GiaTri}" Text="{Binding TenKhachHang}" />
                        <TextBlock Grid.Row="5" Style="{StaticResource Nhan}" Text="Giờ vào"
                                   Visibility="{Binding ThoiGianVao, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource GiaTri}" Text="{Binding ThoiGianVao, StringFormat=dd/MM/yyyy HH:mm}" />
                        <TextBlock Grid.Row="6" Style="{StaticResource Nhan}" Text="Giờ ra"
                                   Visibility="{Binding ThoiGianRa, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource GiaTri}" Text="{Binding ThoiGianRa, StringFormat=dd/MM/yyyy HH:mm}" />
                        <TextBlock Grid.Row="7" Style="{StaticResource Nhan}" Text="Khung gửi / số lần tính (N)"
                                   Visibility="{Binding KhungGui, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource GiaTri}"
                                   Visibility="{Binding KhungGui, Converter={StaticResource NullToVisibility}}">
                            <Run Text="{Binding KhungGui, Mode=OneWay}" /><Run Text=" – N = " /><Run Text="{Binding SoNgay, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Grid.Row="8" Style="{StaticResource Nhan}" Text="Số tháng"
                                   Visibility="{Binding SoThang, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource GiaTri}" Text="{Binding SoThang}" />
                        <TextBlock Grid.Row="9" Style="{StaticResource Nhan}" Text="Hạn vé tháng"
                                   Visibility="{Binding NgayHetHan, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource GiaTri}" Text="{Binding NgayHetHan, StringFormat=dd/MM/yyyy}" />
                    </Grid>

                    <Separator Margin="0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Nhan}" Text="Tiền gốc" />
                        <TextBlock Grid.Column="1" Style="{StaticResource GiaTri}" Text="{Binding TongTienGoc, Converter={StaticResource Money}}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource Nhan}" Text="Giảm giá" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource GiaTri}" Text="{Binding SoTienGiam, Converter={StaticResource Money}, StringFormat=- {0}}" />
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource GiaTri}" FontStyle="Italic" FontSize="11" Text="{Binding KhuyenMai}"
                                   Visibility="{Binding KhuyenMai, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource Nhan}" Text="Tiền phạt (mất thẻ)" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource GiaTri}" Text="{Binding TienPhat, Converter={StaticResource Money}}" />
                        <TextBlock Grid.Row="4" Text="TỔNG CỘNG" FontWeight="Bold" FontSize="16" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource GiaTri}" FontWeight="Bold" FontSize="18" Margin="0,8,0,0"
                                   Text="{Binding TongTien, Converter={StaticResource Money}}" />
                    </Grid>
                    <Separator Margin="0,10" />
                    <TextBlock><Run Text="Phương thức: " Foreground="#555" /><Run Text="{Binding PhuongThucTT, Mode=OneWay}" /></TextBlock>
                    <TextBlock><Run Text="Nhân viên: " Foreground="#555" /><Run Text="{Binding NhanVien, Mode=OneWay}" /></TextBlock>
                    <TextBlock Text="Cảm ơn quý khách!" HorizontalAlignment="Center" Margin="0,16,0,0" FontStyle="Italic" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
            <ui:Button Content="In hóa đơn" Appearance="Primary" Icon="{ui:SymbolIcon Print24}" Margin="0,0,8,0" Click="In_Click" />
            <ui:Button Content="Đóng" IsCancel="True" Click="Dong_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
