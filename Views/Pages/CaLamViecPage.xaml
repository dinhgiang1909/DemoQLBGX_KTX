<Page x:Class="QLBGX.Views.Pages.CaLamViecPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Ca làm việc">
    <Grid Margin="20,12,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Ca làm việc" Style="{StaticResource TieuDeTrang}" />

        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <DataGrid Style="{StaticResource LuoiChiDoc}" ItemsSource="{Binding Items}" SelectedItem="{Binding Chon}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã ca" Binding="{Binding MaCa}" />
                    <DataGridTextColumn Header="Tên ca" Binding="{Binding TenCa}" Width="*" />
                    <DataGridTextColumn Header="Bắt đầu" Binding="{Binding GioBatDau, StringFormat=HH:mm}" />
                    <DataGridTextColumn Header="Kết thúc" Binding="{Binding GioKetThuc, StringFormat=HH:mm}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Sửa giờ ca (chọn ca bên trái)" Style="{StaticResource TieuDeKhoi}" />
                <TextBlock Text="Tên ca" Style="{StaticResource NhanO}" />
                <ui:TextBox Text="{Binding FTen, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Giờ bắt đầu (HH:mm)" Style="{StaticResource NhanO}" />
                <ui:TextBox Text="{Binding FBatDau, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Giờ kết thúc (HH:mm; ca qua đêm được phép kết thúc sớm hơn bắt đầu)" Style="{StaticResource NhanO}" TextWrapping="Wrap" />
                <ui:TextBox Text="{Binding FKetThuc, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button Margin="0,16,0,0" Content="Lưu" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Command="{Binding LuuCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
