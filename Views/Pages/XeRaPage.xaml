<Page x:Class="QLBGX.Views.Pages.XeRaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Xử lý xe ra">
    <Page.Resources>
        <Style x:Key="Nhan2" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,3,12,3" />
        </Style>
        <Style x:Key="GT2" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20,12,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Tiêu đề + barrier + kết quả -->
            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="Xử lý xe RA &amp; thanh toán" Style="{StaticResource TieuDeTrang}" Margin="0" VerticalAlignment="Center" />
                <Border DockPanel.Dock="Right" Padding="12,6" CornerRadius="16" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#8A8A8A" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BarrierMo}" Value="True">
                                    <Setter Property="Background" Value="#107C10" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="LockOpen24" Foreground="White" Margin="0,0,6,0" />
                        <TextBlock Foreground="White" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="BARRIER: ĐÓNG" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BarrierMo}" Value="True">
                                            <Setter Property="Text" Value="BARRIER: MỞ" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <ui:ProgressRing DockPanel.Dock="Right" IsIndeterminate="True" Width="22" Height="22" Margin="0,0,12,0"
                                 Visibility="{Binding DangXuLy, Converter={StaticResource BoolToVis}}" />
                <Border Margin="24,0,12,0" Padding="12,6" CornerRadius="6" VerticalAlignment="Center"
                        Background="{Binding MucKetQua, Converter={StaticResource MucBrush}}"
                        Visibility="{Binding KetQua, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="{Binding KetQua}" Foreground="White" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                </Border>
            </DockPanel>

            <!-- 1. Tìm lượt gửi -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Content="Khách mất thẻ" IsChecked="{Binding MatThe}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Grid Grid.Column="1">
                        <ComboBox x:Name="CboThe" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="MaThe"
                                  FontSize="18" FontWeight="SemiBold"
                                  ItemsSource="{Binding GoiYThes}"
                                  Text="{Binding MaTheNhap, UpdateSourceTrigger=PropertyChanged}"
                                  PreviewKeyDown="CboThe_PreviewKeyDown" DropDownClosed="CboThe_DropDownClosed"
                                  Visibility="{Binding MatThe, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding HienThi}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ui:TextBox x:Name="TxtBienSoTim" FontSize="18" FontWeight="SemiBold" CharacterCasing="Upper"
                                    PlaceholderText="Nhập biển số xe để tìm lượt gửi rồi nhấn Enter"
                                    Text="{Binding BienSoTimKiem, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="{Binding MatThe, Converter={StaticResource BoolToVis}}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding TimLuotCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                    </Grid>
                    <ui:Button Grid.Column="2" Margin="12,0,0,0" Height="40" Content="Tìm lượt gửi" Appearance="Secondary"
                               Icon="{ui:SymbolIcon Search24}" Command="{Binding TimLuotCommand}" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,16,0,0" Visibility="{Binding CoLuot, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>

                <!-- 2-3. So sánh vào / ra -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Đối chiếu lúc vào / lúc ra" Style="{StaticResource TieuDeKhoi}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Ảnh lúc vào" Style="{StaticResource NhanO}" Margin="0,0,0,4" />
                                <Border Height="240" Background="#1E1E1E" CornerRadius="6">
                                    <Grid>
                                        <TextBlock Text="Không có ảnh" Foreground="#AAA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Luot.HinhAnhVao, Converter={StaticResource PathToImage}}" Stretch="Uniform" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="Biển số lúc vào" Style="{StaticResource NhanO}" />
                                <TextBlock Text="{Binding Luot.BienSoVao}" FontSize="28" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ảnh lúc ra" Style="{StaticResource NhanO}" Margin="0,0,0,4" />
                                <Border Height="240" Background="#1E1E1E" CornerRadius="6">
                                    <Grid>
                                        <TextBlock Text="Chưa chụp" Foreground="#AAA" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding DuongDanAnhRa, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                                        <Image Source="{Binding DuongDanAnhRa, Converter={StaticResource PathToImage}}" Stretch="Uniform" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="Biển số lúc ra (sửa được)" Style="{StaticResource NhanO}" />
                                <ui:TextBox x:Name="TxtBienSoRa" FontSize="24" FontWeight="Bold" CharacterCasing="Upper"
                                            Text="{Binding BienSoRa, UpdateSourceTrigger=PropertyChanged}">
                                    <ui:TextBox.Style>
                                        <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LechBienSo}" Value="True">
                                                    <Setter Property="Foreground" Value="#C42B1C" />
                                                    <Setter Property="BorderBrush" Value="#C42B1C" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:TextBox.Style>
                                </ui:TextBox>
                            </StackPanel>
                        </Grid>
                        <ui:Button Margin="0,10,0,0" HorizontalAlignment="Stretch" Content="Chụp ảnh lúc ra (chọn tệp)   [F2]"
                                   Icon="{ui:SymbolIcon Camera24}" Command="{Binding ChupAnhCommand}" />

                        <Border Margin="0,10,0,0" Padding="10" CornerRadius="6" BorderThickness="2" BorderBrush="#C42B1C"
                                Visibility="{Binding CanXacNhanGiayTo, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Foreground="#C42B1C" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Text="Biển số lúc ra khác lúc vào hoặc khách mất thẻ: phải kiểm tra giấy tờ xe trước khi cho ra." />
                                <CheckBox Margin="0,6,0,0" Content="Đã kiểm tra giấy tờ xe" FontWeight="SemiBold"
                                          IsChecked="{Binding XacNhanGiayTo}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 4-8. Cước & thanh toán -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding Luot.LoaiVe}" FontSize="22" FontWeight="Bold"
                                   Foreground="{Binding Luot.LoaiVe, Converter={StaticResource TrangThaiBrush}}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Nhan2}" Text="Mã vé / thẻ / khu" />
                            <TextBlock Grid.Column="1" Style="{StaticResource GT2}">
                                <Run Text="{Binding Luot.MaVe, Mode=OneWay, StringFormat=#{0}}" /> – <Run Text="{Binding Luot.MaThe, Mode=OneWay}" /> – <Run Text="{Binding Luot.MaKhuVuc, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Grid.Row="1" Style="{StaticResource Nhan2}" Text="Loại xe" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource GT2}" Text="{Binding Luot.TenLoai}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource Nhan2}" Text="Thời gian vào" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource GT2}" Text="{Binding Luot.ThoiGianVao, StringFormat=dd/MM/yyyy HH:mm}" />
                            <TextBlock Grid.Row="3" Style="{StaticResource Nhan2}" Text="Đã gửi" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource GT2}" Text="{Binding ThoiGianDaGui}" />
                            <TextBlock Grid.Row="4" Style="{StaticResource Nhan2}" Text="Khung gửi / N" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource GT2}">
                                <Run Text="{Binding Luot.KhungGui, Mode=OneWay, TargetNullValue=–}" /> – N = <Run Text="{Binding Luot.SoNgay, Mode=OneWay, TargetNullValue=0}" />
                            </TextBlock>
                            <TextBlock Grid.Row="5" Style="{StaticResource Nhan2}" Text="Đơn giá" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource GT2}" Text="{Binding Luot.DonGia, Converter={StaticResource Money}}" />
                            <TextBlock Grid.Row="6" Style="{StaticResource Nhan2}" Text="Tiền gốc" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource GT2}" Text="{Binding Luot.TongTienGoc, Converter={StaticResource Money}}" />
                            <TextBlock Grid.Row="7" Style="{StaticResource Nhan2}" Text="Trạng thái lượt" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource GT2}" Text="{Binding Luot.TrangThai}"
                                       Foreground="{Binding Luot.TrangThai, Converter={StaticResource TrangThaiBrush}}" />
                            <TextBlock Grid.Row="8" Style="{StaticResource Nhan2}" Text="Ghi chú" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource GT2}" FontWeight="Normal" Text="{Binding Luot.GhiChu}" />
                        </Grid>

                        <StackPanel Visibility="{Binding HienThuTien, Converter={StaticResource BoolToVis}}">
                            <Separator Margin="0,8" />
                            <TextBlock Text="Khuyến mãi" Style="{StaticResource NhanO}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding KhuyenMais}" SelectedItem="{Binding KhuyenMaiChon}" DisplayMemberPath="HienThi" />
                            <TextBlock Margin="0,4,0,0">
                                <Run Text="Giảm dự kiến:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Run Text="{Binding SoTienGiamDuKien, Mode=OneWay, Converter={StaticResource Money}}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Margin="0,2,0,0" Foreground="#C42B1C"
                                       Visibility="{Binding PhiMatTheHienThi, Converter={StaticResource NullToVisibility}}">
                                <Run Text="Phí mất thẻ:" /> <Run Text="{Binding PhiMatTheHienThi, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Text="Phương thức thanh toán" Style="{StaticResource NhanO}" />
                            <ComboBox ItemsSource="{Binding PhuongThucs}" SelectedItem="{Binding PhuongThucChon}" />
                            <TextBlock Margin="0,12,0,0" Text="TỔNG TIỀN DỰ KIẾN" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding TongDuKien, Converter={StaticResource Money}}" FontSize="40" FontWeight="Bold"
                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        </StackPanel>

                        <ui:InfoBar Margin="0,8,0,0" Severity="Warning" IsClosable="False" Title="Lưu ý"
                                    Message="{Binding ThongBaoQuyen}"
                                    IsOpen="{Binding ThongBaoQuyen, Converter={StaticResource HasText}}"
                                    Visibility="{Binding ThongBaoQuyen, Converter={StaticResource NullToVisibility}}" />

                        <TextBlock Text="Ghi chú" Style="{StaticResource NhanO}" />
                        <ui:TextBox Text="{Binding GhiChu, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ghi chú (tùy chọn)" />

                        <ui:Button Margin="0,12,0,0" Height="48" HorizontalAlignment="Stretch" Appearance="Primary" FontSize="16"
                                   Content="Thanh toán &amp; Mở barrier   [F5]" Icon="{ui:SymbolIcon Payment24}"
                                   IsEnabled="{Binding CoTheThanhToan}" Command="{Binding ThanhToanCommand}" />
                        <ui:Button Margin="0,8,0,0" Height="44" HorizontalAlignment="Stretch" Appearance="Success"
                                   Content="Giải quyết &amp; cho ra" Icon="{ui:SymbolIcon ShieldCheckmark24}"
                                   Visibility="{Binding CoTheGiaiQuyet, Converter={StaticResource BoolToVis}}"
                                   Command="{Binding GiaiQuyetCommand}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ui:Button HorizontalAlignment="Stretch" Appearance="Caution" Content="Giữ xe (Chờ xử lý)"
                                       Icon="{ui:SymbolIcon HandRight24}" IsEnabled="{Binding CoTheGiuXe}" Command="{Binding GiuXeCommand}" />
                            <ui:Button Grid.Column="2" HorizontalAlignment="Stretch" Content="Làm mới [Esc]"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding LamMoiCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
