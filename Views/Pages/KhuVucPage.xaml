<Page x:Class="QLBGX.Views.Pages.KhuVucPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Khu vực đỗ">
    <Grid Margin="20,12,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Danh mục khu vực đỗ" Style="{StaticResource TieuDeTrang}" />

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DataGrid Style="{StaticResource LuoiChiDoc}" ItemsSource="{Binding Items}" SelectedItem="{Binding Chon}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã" Binding="{Binding MaKhuVuc}" />
                    <DataGridTextColumn Header="Tên khu vực" Binding="{Binding TenKhuVuc}" Width="*" />
                    <DataGridTextColumn Header="Loại xe" Binding="{Binding MaLoaiXe}" />
                    <DataGridTextColumn Header="Sức chứa" Binding="{Binding SucChua}" />
                    <DataGridTextColumn Header="Đang gửi" Binding="{Binding SoXeDangGui}" />
                    <DataGridTemplateColumn Header="Trạng thái">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TrangThai}" Foreground="{Binding TrangThai, Converter={StaticResource TrangThaiBrush}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Thông tin khu vực" Style="{StaticResource TieuDeKhoi}" />
                <TextBlock Text="Mã khu vực" Style="{StaticResource NhanO}" />
                <ui:TextBox Text="{Binding FMa, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding LaThemMoi}" CharacterCasing="Upper" />
                <TextBlock Text="Tên khu vực" Style="{StaticResource NhanO}" />
                <ui:TextBox Text="{Binding FTen, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource NhanO}">
                    <Run Text="Sức chứa (&gt; 0; hiện đang gửi" /> <Run Text="{Binding FSoXeDangGui, Mode=OneWay}" FontWeight="Bold" /><Run Text=" xe)" />
                </TextBlock>
                <ui:TextBox Text="{Binding FSucChua, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Loại xe" Style="{StaticResource NhanO}" />
                <ComboBox ItemsSource="{Binding LoaiXes}" SelectedValuePath="MaLoaiXe" DisplayMemberPath="TenLoai" SelectedValue="{Binding FMaLoaiXe}" />
                <TextBlock Text="Trạng thái (khu Bảo trì không nhận xe mới)" Style="{StaticResource NhanO}" />
                <ComboBox ItemsSource="{Binding TrangThais}" SelectedItem="{Binding FTrangThai}" />
                <TextBlock Text="Ghi chú" Style="{StaticResource NhanO}" />
                <ui:TextBox Text="{Binding FGhiChu, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <ui:Button Content="Thêm mới" Icon="{ui:SymbolIcon Add24}" Command="{Binding ThemMoiCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="Lưu" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Command="{Binding LuuCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
