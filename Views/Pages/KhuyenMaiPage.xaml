<Page x:Class="QLBGX.Views.Pages.KhuyenMaiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Khuyến mãi">
    <Grid Margin="20,12,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Chương trình khuyến mãi" Style="{StaticResource TieuDeTrang}" />

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DataGrid Style="{StaticResource LuoiChiDoc}" ItemsSource="{Binding Items}" SelectedItem="{Binding Chon}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã" Binding="{Binding MaKhuyenMai}" />
                    <DataGridTextColumn Header="Tên chương trình" Binding="{Binding TenChuongTrinh}" Width="*" />
                    <DataGridTextColumn Header="% giảm" Binding="{Binding PhanTramGiam, StringFormat=0.##}" />
                    <DataGridTextColumn Header="Loại xe" Binding="{Binding MaLoaiXe, TargetNullValue=Tất cả}" />
                    <DataGridTextColumn Header="Khung" Binding="{Binding KhungGuiApDung, TargetNullValue=Tất cả}" />
                    <DataGridTextColumn Header="Từ" Binding="{Binding NgayBatDau, StringFormat=dd/MM/yyyy}" />
                    <DataGridTextColumn Header="Đến" Binding="{Binding NgayKetThuc, StringFormat=dd/MM/yyyy}" />
                    <DataGridTemplateColumn Header="Trạng thái">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TrangThai}" Foreground="{Binding TrangThai, Converter={StaticResource TrangThaiBrush}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Thông tin khuyến mãi" Style="{StaticResource TieuDeKhoi}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Mã" Style="{StaticResource NhanO}" />
                        <ui:TextBox Text="{Binding FMa, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding LaThemMoi}" CharacterCasing="Upper" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="% giảm (0–100]" Style="{StaticResource NhanO}" />
                        <ui:TextBox Text="{Binding FPhanTram, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Tên chương trình" Style="{StaticResource NhanO}" />
                <ui:TextBox Text="{Binding FTen, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Điều kiện áp dụng" Style="{StaticResource NhanO}" />
                <ui:TextBox Text="{Binding FDieuKien, UpdateSourceTrigger=PropertyChanged}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Loại xe" Style="{StaticResource NhanO}" />
                        <ComboBox ItemsSource="{Binding LoaiXes}" SelectedItem="{Binding FLoaiXe}" DisplayMemberPath="Ten" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Khung gửi" Style="{StaticResource NhanO}" />
                        <ComboBox ItemsSource="{Binding KhungGuis}" SelectedItem="{Binding FKhungGui}" DisplayMemberPath="Ten" />
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Từ ngày" Style="{StaticResource NhanO}" />
                        <DatePicker SelectedDate="{Binding FTuNgay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Đến ngày" Style="{StaticResource NhanO}" />
                        <DatePicker SelectedDate="{Binding FDenNgay}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Trạng thái" Style="{StaticResource NhanO}" />
                <ComboBox ItemsSource="{Binding TrangThais}" SelectedItem="{Binding FTrangThai}" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <ui:Button Content="Thêm mới" Icon="{ui:SymbolIcon Add24}" Command="{Binding ThemMoiCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="Lưu" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Command="{Binding LuuCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="Ngừng" Icon="{ui:SymbolIcon Prohibited24}" Command="{Binding NgungCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
