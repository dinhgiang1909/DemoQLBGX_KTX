<Page x:Class="QLBGX.Views.Pages.BaoCaoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Báo cáo">
    <Page.Resources>
        <Style x:Key="NutXuat" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Content" Value="Xuất Excel / CSV" />
            <Setter Property="Command" Value="{Binding XuatCommand}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <DataTemplate x:Key="CotTrangThai">
            <TextBlock Text="{Binding TrangThai}" Foreground="{Binding TrangThai, Converter={StaticResource TrangThaiBrush}}" />
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="20,12,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock Text="Báo cáo &amp; cảnh báo" Style="{StaticResource TieuDeTrang}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ui:ProgressRing IsIndeterminate="True" Width="22" Height="22" Margin="0,0,12,0"
                                 Visibility="{Binding DangXuLy, Converter={StaticResource BoolToVis}}" />
                <ui:Button Content="Làm mới" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding LamMoiCommand}" />
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding TabChon}">
            <!-- 0. Doanh thu -->
            <TabItem Header="Doanh thu" Visibility="{Binding XemDoanhThu, Converter={StaticResource BoolToVis}}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource NutXuat}" Icon="{ui:SymbolIcon ArrowDownload24}" CommandParameter="DoanhThu" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Từ" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <DatePicker SelectedDate="{Binding TuNgay}" Width="150" />
                            <TextBlock Text="đến" VerticalAlignment="Center" Margin="8,0,6,0" />
                            <DatePicker SelectedDate="{Binding DenNgay}" Width="150" />
                            <ui:Button Margin="8,0,0,0" Appearance="Primary" Content="Xem báo cáo" Icon="{ui:SymbolIcon DataBarVertical24}"
                                       Command="{Binding XemDoanhThuCommand}" />
                            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontSize="16">
                                <Run Text="Tổng doanh thu:" /> <Run Text="{Binding TongDoanhThu, Mode=OneWay}" FontWeight="Bold" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>

                    <!-- Biểu đồ cột doanh thu theo ngày -->
                    <Border Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Doanh thu theo ngày" Style="{StaticResource TieuDeKhoi}" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding BieuDo}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="72" Margin="4,0" ToolTip="{Binding GiaTri}">
                                                <Grid Height="200">
                                                    <StackPanel VerticalAlignment="Bottom">
                                                        <TextBlock Text="{Binding GiaTri}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                                        <Border Height="{Binding ChieuCao}" Width="40" CornerRadius="4,4,0,0"
                                                                Background="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding Nhan}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <DataGrid Style="{StaticResource LuoiChiDoc}" ItemsSource="{Binding BaoCao.ChiTiet}" MaxHeight="520">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ngày" Binding="{Binding Ngay, StringFormat=dd/MM/yyyy}" />
                                <DataGridTextColumn Header="Loại HĐ" Binding="{Binding LoaiHoaDon}" />
                                <DataGridTextColumn Header="Loại xe" Binding="{Binding MaLoaiXe}" />
                                <DataGridTextColumn Header="Khung" Binding="{Binding KhungGui}" />
                                <DataGridTextColumn Header="Phương thức" Binding="{Binding PhuongThucTT}" />
                                <DataGridTextColumn Header="Số HĐ" Binding="{Binding SoHoaDon}" />
                                <DataGridTextColumn Header="Tiền gốc" Binding="{Binding TongTienGoc, Converter={StaticResource Money}}" />
                                <DataGridTextColumn Header="Giảm" Binding="{Binding TongGiam, Converter={StaticResource Money}}" />
                                <DataGridTextColumn Header="Phạt" Binding="{Binding TongPhat, Converter={StaticResource Money}}" />
                                <DataGridTextColumn Header="Doanh thu" Binding="{Binding DoanhThu, Converter={StaticResource Money}}" FontWeight="SemiBold" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Theo loại xe – khung gửi" Style="{StaticResource TieuDeKhoi}" />
                            <DataGrid Style="{StaticResource LuoiChiDoc}" ItemsSource="{Binding BaoCao.TheoLoaiXe}" MaxHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Loại xe" Binding="{Binding MaLoaiXe}" />
                                    <DataGridTextColumn Header="Loại HĐ" Binding="{Binding LoaiHoaDon}" />
                                    <DataGridTextColumn Header="Khung" Binding="{Binding KhungGui}" />
                                    <DataGridTextColumn Header="Số HĐ" Binding="{Binding SoHoaDon}" />
                                    <DataGridTextColumn Header="Doanh thu" Binding="{Binding DoanhThu, Converter={StaticResource Money}}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Theo phương thức thanh toán" Style="{StaticResource TieuDeKhoi}" Margin="0,12,0,8" />
                            <DataGrid Style="{StaticResource LuoiChiDoc}" ItemsSource="{Binding BaoCao.TheoPhuongThuc}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Phương thức" Binding="{Binding PhuongThucTT}" />
                                    <DataGridTextColumn Header="Số HĐ" Binding="{Binding SoHoaDon}" />
                                    <DataGridTextColumn Header="Doanh thu" Binding="{Binding DoanhThu, Converter={StaticResource Money}}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 1. Theo ca -->
            <TabItem Header="Theo ca" Visibility="{Binding XemTheoCa, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource NutXuat}" Icon="{ui:SymbolIcon ArrowDownload24}" CommandParameter="TheoCa" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Từ" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <DatePicker SelectedDate="{Binding TuNgay}" Width="150" />
                            <TextBlock Text="đến" VerticalAlignment="Center" Margin="8,0,6,0" />
                            <DatePicker SelectedDate="{Binding DenNgay}" Width="150" />
                            <ui:Button Margin="8,0,0,0" Content="Xem" Icon="{ui:SymbolIcon Search24}" Command="{Binding XemTheoCaCommand}" />
                            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="{Binding GhiChuTheoCa}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid Style="{StaticResource LuoiChiDoc}" ItemsSource="{Binding TheoCa}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding MaLichSuCa}" />
                            <DataGridTextColumn Header="Ngày ca" Binding="{Binding NgayCa, StringFormat=dd/MM/yyyy}" />
                            <DataGridTextColumn Header="Ca" Binding="{Binding TenCa}" />
                            <DataGridTextColumn Header="Nhân viên" Binding="{Binding TenNv}" />
                            <DataGridTextColumn Header="Chức vụ" Binding="{Binding ChucVu}" />
                            <DataGridTextColumn Header="Vào" Binding="{Binding TongLuotVao}" />
                            <DataGridTextColumn Header="Ra" Binding="{Binding TongLuotRa}" />
                            <DataGridTextColumn Header="HĐ" Binding="{Binding SoHoaDon}" />
                            <DataGridTextColumn Header="Tiền mặt" Binding="{Binding DoanhThuTienMat, Converter={StaticResource Money}}" />
                            <DataGridTextColumn Header="Chuyển khoản" Binding="{Binding DoanhThuChuyenKhoan, Converter={StaticResource Money}}" />
                            <DataGridTextColumn Header="Tổng" Binding="{Binding TongDoanhThu, Converter={StaticResource Money}}" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Thực nộp" Binding="{Binding TienMatThucNop, Converter={StaticResource Money}}" />
                            <DataGridTextColumn Header="Chênh lệch" Binding="{Binding ChenhLech, Converter={StaticResource Money}}" />
                            <DataGridTemplateColumn Header="Trạng thái" CellTemplate="{StaticResource CotTrangThai}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 2. Tỷ lệ lấp đầy -->
            <TabItem Header="Tỷ lệ lấp đầy">
                <DockPanel Margin="12">
                    <ui:Button DockPanel.Dock="Top" Style="{StaticResource NutXuat}" Icon="{ui:SymbolIcon ArrowDownload24}" CommandParameter="LapDay" Margin="0,0,0,8" />
                    <DataGrid Style="{StaticResource LuoiChiDoc}" ItemsSource="{Binding LapDay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Khu vực" Binding="{Binding MaKhuVuc}" />
                            <DataGridTextColumn Header="Tên" Binding="{Binding TenKhuVuc}" Width="*" />
                            <DataGridTextColumn Header="Loại xe" Binding="{Binding MaLoaiXe}" />
                            <DataGridTemplateColumn Header="Trạng thái">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TrangThaiKhuVuc}" Foreground="{Binding TrangThaiKhuVuc, Converter={StaticResource TrangThaiBrush}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Sức chứa" Binding="{Binding SucChua}" />
                            <DataGridTextColumn Header="Đang gửi" Binding="{Binding SoXeDangGui}" />
                            <DataGridTextColumn Header="Chỗ trống" Binding="{Binding ChoTrong}" />
                            <DataGridTextColumn Header="Tỷ lệ (%)" Binding="{Binding TyLeLapDay, StringFormat=0.##}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 3. Xe tồn đọng -->
            <TabItem Header="Xe tồn đọng">
                <DockPanel Margin="12">
                    <ui:Button DockPanel.Dock="Top" Style="{StaticResource NutXuat}" Icon="{ui:SymbolIcon ArrowDownload24}" CommandParameter="TonDong" Margin="0,0,0,8" />
                    <DataGrid Style="{StaticResource LuoiChiDoc}" ItemsSource="{Binding TonDong}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lượt" Binding="{Binding MaVe}" />
                            <DataGridTextColumn Header="Biển số" Binding="{Binding BienSo}" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Loại xe" Binding="{Binding TenLoai}" />
                            <DataGridTextColumn Header="Khu" Binding="{Binding MaKhuVuc}" />
                            <DataGridTextColumn Header="Thẻ" Binding="{Binding MaThe}" />
                            <DataGridTextColumn Header="Loại thẻ" Binding="{Binding LoaiThe}" />
                            <DataGridTextColumn Header="Giờ vào" Binding="{Binding ThoiGianVao, StringFormat=dd/MM/yyyy HH:mm}" />
                            <DataGridTextColumn Header="Số ngày" Binding="{Binding SoNgayDaGui}" />
                            <DataGridTemplateColumn Header="Trạng thái" CellTemplate="{StaticResource CotTrangThai}" />
                            <DataGridTextColumn Header="Cảnh báo" Binding="{Binding LoaiCanhBao}" Width="*" Foreground="#C42B1C" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 4. Chờ xử lý -->
            <TabItem Header="Lượt chờ xử lý">
                <DockPanel Margin="12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource NutXuat}" Icon="{ui:SymbolIcon ArrowDownload24}" CommandParameter="ChoXuLy" />
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Quản lý giải quyết ở màn hình Xe ra: tick &quot;Khách mất thẻ&quot; hoặc quẹt thẻ của lượt → &quot;Giải quyết &amp; cho ra&quot;." />
                    </DockPanel>
                    <DataGrid Style="{StaticResource LuoiChiDoc}" ItemsSource="{Binding ChoXuLy}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lượt" Binding="{Binding MaVe}" />
                            <DataGridTextColumn Header="Biển số vào" Binding="{Binding BienSo}" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Biển số ra" Binding="{Binding BienSoRa}" Foreground="#C42B1C" />
                            <DataGridTextColumn Header="Thẻ" Binding="{Binding MaThe}" />
                            <DataGridTextColumn Header="Giờ vào" Binding="{Binding ThoiGianVao, StringFormat=dd/MM/yyyy HH:mm}" />
                            <DataGridTextColumn Header="Ghi chú / lý do" Binding="{Binding GhiChu}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 5. Lệch biển số -->
            <TabItem Header="Lệch biển số">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:Button Style="{StaticResource NutXuat}" Icon="{ui:SymbolIcon ArrowDownload24}" CommandParameter="LechBienSo" Margin="0,0,0,8" />
                    <DataGrid Grid.Row="1" Style="{StaticResource LuoiChiDoc}" ItemsSource="{Binding LechBienSo}" SelectedItem="{Binding LechChon}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lượt" Binding="{Binding MaVe}" />
                            <DataGridTextColumn Header="Biển số vào" Binding="{Binding BienSoVao}" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Biển số ra" Binding="{Binding BienSoRa}" FontWeight="SemiBold" Foreground="#C42B1C" />
                            <DataGridTextColumn Header="Vào" Binding="{Binding ThoiGianVao, StringFormat=dd/MM/yyyy HH:mm}" />
                            <DataGridTextColumn Header="Ra" Binding="{Binding ThoiGianRa, StringFormat=dd/MM/yyyy HH:mm}" />
                            <DataGridTemplateColumn Header="Trạng thái" CellTemplate="{StaticResource CotTrangThai}" />
                            <DataGridTextColumn Header="NV vào" Binding="{Binding MaNv}" />
                            <DataGridTextColumn Header="NV ra" Binding="{Binding MaNvra}" />
                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="0,8,0,0" Height="220">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Background="#1E1E1E" CornerRadius="6">
                            <Grid>
                                <TextBlock Text="Ảnh vào (chọn một dòng)" Foreground="#AAA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding LechChon.HinhAnhVao, Converter={StaticResource PathToImage}}" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Background="#1E1E1E" CornerRadius="6">
                            <Grid>
                                <TextBlock Text="Ảnh ra" Foreground="#AAA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding LechChon.HinhAnhRa, Converter={StaticResource PathToImage}}" Stretch="Uniform" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 6. Vé tháng sắp hết hạn -->
            <TabItem Header="Vé tháng sắp hết hạn">
                <DockPanel Margin="12">
                    <ui:Button DockPanel.Dock="Top" Style="{StaticResource NutXuat}" Icon="{ui:SymbolIcon ArrowDownload24}" CommandParameter="VeThang" Margin="0,0,0,8" />
                    <DataGrid Style="{StaticResource LuoiChiDoc}" ItemsSource="{Binding VeThang}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding MaThanhVien}" />
                            <DataGridTextColumn Header="Khách hàng" Binding="{Binding TenKh}" Width="*" />
                            <DataGridTextColumn Header="MSSV/Mã CB" Binding="{Binding MaDinhDanh}" />
                            <DataGridTextColumn Header="SĐT" Binding="{Binding Sdt}" />
                            <DataGridTextColumn Header="Biển số" Binding="{Binding BienSo}" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Thẻ" Binding="{Binding MaThe}" />
                            <DataGridTextColumn Header="Hết hạn" Binding="{Binding NgayHetHan, StringFormat=dd/MM/yyyy}" />
                            <DataGridTextColumn Header="Còn (ngày)" Binding="{Binding SoNgayConLai}" />
                            <DataGridTemplateColumn Header="Trạng thái" CellTemplate="{StaticResource CotTrangThai}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
