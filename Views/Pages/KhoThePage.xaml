<Page x:Class="QLBGX.Views.Pages.KhoThePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:helpers="clr-namespace:QLBGX.Helpers"
      Title="Kho thẻ">
    <Grid Margin="20,12,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1*" MinWidth="280" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.ColumnSpan="3">
            <TextBlock Text="Kho thẻ" Style="{StaticResource TieuDeTrang}" />
            <ui:ProgressRing DockPanel.Dock="Right" HorizontalAlignment="Right" IsIndeterminate="True" Width="22" Height="22"
                             Visibility="{Binding DangXuLy, Converter={StaticResource BoolToVis}}" />
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <ComboBox Width="170" ItemsSource="{Binding LoaiThes}" SelectedItem="{Binding LocLoai}" DisplayMemberPath="Ten" Margin="0,0,8,0" />
            <ComboBox Width="190" ItemsSource="{Binding TrangThais}" SelectedItem="{Binding LocTrangThai}" DisplayMemberPath="Ten" Margin="0,0,8,0" />
            <ui:TextBox Width="160" PlaceholderText="Mã thẻ" Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0">
                <ui:TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding TimCommand}" />
                </ui:TextBox.InputBindings>
            </ui:TextBox>
            <ui:Button Content="Lọc" Icon="{ui:SymbolIcon Search24}" Command="{Binding TimCommand}" />
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="{Binding SoLuong}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
            <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,6" BorderThickness="4,0,0,0" CornerRadius="2"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{x:Static helpers:MucTrangThaiBrushConverter.Do}"
                    Visibility="{Binding CanhBaoKho, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding CanhBaoKho}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{x:Static helpers:MucTrangThaiBrushConverter.Do}" />
            </Border>
            <DataGrid Style="{StaticResource LuoiChiDoc}" ItemsSource="{Binding Items}" SelectedItem="{Binding Chon}" MaxHeight="680">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã thẻ" Binding="{Binding MaThe}" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Loại" Binding="{Binding LoaiThe}" />
                    <DataGridTemplateColumn Header="Trạng thái">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TrangThai}" Foreground="{Binding TrangThai, Converter={StaticResource TrangThaiBrush}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Khai báo" Binding="{Binding NgayKhaiBao, StringFormat=dd/MM/yyyy}" />
                    <DataGridTextColumn Header="Đang gắn với" Binding="{Binding GanVoi}" Width="2*" />
                    <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Quản lý thẻ" Style="{StaticResource TieuDeKhoi}" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Thu ngân, Bảo vệ chỉ được xem. Khai báo, khóa và mở khóa thẻ chỉ dành cho Quản lý."
                           Visibility="{Binding LaQuanLy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                <StackPanel IsEnabled="{Binding LaQuanLy}">
                    <TextBlock Text="Khai báo thẻ mới – mã thẻ" Style="{StaticResource NhanO}" />
                    <ui:TextBox CharacterCasing="Upper" PlaceholderText="VD: TL061" Text="{Binding FMaThe, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Loại thẻ" Style="{StaticResource NhanO}" />
                    <ComboBox ItemsSource="{Binding LoaiTheMoi}" SelectedItem="{Binding FLoaiThe}" />
                    <ui:Button Margin="0,12,0,0" HorizontalAlignment="Stretch" Content="Khai báo thẻ" Appearance="Primary"
                               Icon="{ui:SymbolIcon Add24}" Command="{Binding KhaiBaoCommand}" />
                    <Separator Margin="0,16" />
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Thẻ đang chọn:" /> <Run Text="{Binding Chon.MaThe, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text="{Binding Chon.TrangThai, Mode=OneWay}" />
                    </TextBlock>
                    <ui:Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Content="Khóa thẻ (hỏng / thất lạc)" Appearance="Danger"
                               Icon="{ui:SymbolIcon LockClosed24}" Command="{Binding KhoaCommand}" />
                    <ui:Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Content="Mở khóa thẻ (tìm lại được)" Appearance="Success"
                               Icon="{ui:SymbolIcon LockOpen24}" Command="{Binding MoKhoaCommand}" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Thẻ gắn vé tháng: dùng Khóa vé tháng / Cấp lại thẻ. Thẻ lượt đang có xe trong bãi: xử lý Khách mất thẻ ở Xe ra." />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
