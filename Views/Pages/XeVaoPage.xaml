<Page x:Class="QLBGX.Views.Pages.XeVaoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Xử lý xe vào">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20,12,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <!-- Tiêu đề + barrier + kết quả -->
            <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
                <TextBlock Text="Xử lý xe VÀO" Style="{StaticResource TieuDeTrang}" Margin="0" VerticalAlignment="Center" />
                <Border DockPanel.Dock="Right" Padding="12,6" CornerRadius="16" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#8A8A8A" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BarrierMo}" Value="True">
                                    <Setter Property="Background" Value="#107C10" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="LockOpen24" Foreground="White" Margin="0,0,6,0" />
                        <TextBlock Foreground="White" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="BARRIER: ĐÓNG" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BarrierMo}" Value="True">
                                            <Setter Property="Text" Value="BARRIER: MỞ" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <ui:ProgressRing DockPanel.Dock="Right" IsIndeterminate="True" Width="22" Height="22" Margin="0,0,12,0"
                                 Visibility="{Binding DangXuLy, Converter={StaticResource BoolToVis}}" />
                <Border Margin="24,0,12,0" Padding="12,6" CornerRadius="6" VerticalAlignment="Center"
                        Background="{Binding MucKetQua, Converter={StaticResource MucBrush}}"
                        Visibility="{Binding KetQua, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="{Binding KetQua}" Foreground="White" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                </Border>
            </DockPanel>

            <!-- Camera -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Camera làn vào" Style="{StaticResource TieuDeKhoi}" />
                    <Border Height="340" Background="#1E1E1E" CornerRadius="6">
                        <Grid>
                            <TextBlock Text="Chưa có ảnh" Foreground="#AAA" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding DuongDanAnh, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                            <Image Source="{Binding DuongDanAnh, Converter={StaticResource PathToImage}}" Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <TextBlock Margin="0,4,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding DuongDanAnh}" />
                    <ui:Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Height="40" Content="Chụp ảnh (chọn tệp)   [F2]"
                               Icon="{ui:SymbolIcon Camera24}" Command="{Binding ChupAnhCommand}" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Mẹo demo: đặt tên tệp ảnh theo biển số (ví dụ 59X112345.jpg) để camera mô phỏng tự đọc biển số." />
                </StackPanel>
            </Border>

            <!-- Thông tin -->
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Biển số" Style="{StaticResource NhanO}" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="TxtBienSo" FontSize="30" FontWeight="Bold" PlaceholderText="VD: 59X1-123.45"
                                CharacterCasing="Upper"
                                Text="{Binding BienSo, UpdateSourceTrigger=PropertyChanged}" LostFocus="TxtBienSo_LostFocus" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding BienSoHienThi}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Border Margin="0,6,0,0" Padding="10,6" BorderThickness="4,0,0,0" CornerRadius="2"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{Binding MucBienSo, Converter={StaticResource MucBrush}}"
                            Visibility="{Binding ThongBaoBienSo, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding ThongBaoBienSo}" TextWrapping="Wrap"
                                   Foreground="{Binding MucBienSo, Converter={StaticResource MucBrush}}" FontWeight="SemiBold" />
                    </Border>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Loại xe" Style="{StaticResource NhanO}" />
                            <ComboBox ItemsSource="{Binding LoaiXes}" SelectedItem="{Binding LoaiXeChon}" DisplayMemberPath="TenLoai" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Quẹt thẻ (gõ mã + Enter)" Style="{StaticResource NhanO}" />
                            <ComboBox x:Name="CboThe" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="MaThe"
                                      FontSize="16" FontWeight="SemiBold" StaysOpenOnEdit="True"
                                      ItemsSource="{Binding GoiYThes}"
                                      Text="{Binding MaTheNhap, UpdateSourceTrigger=PropertyChanged}"
                                      PreviewKeyDown="CboThe_PreviewKeyDown" DropDownClosed="CboThe_DropDownClosed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding HienThi}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,6,0,0" Padding="10,6" BorderThickness="4,0,0,0" CornerRadius="2"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{Binding MucKhoThe, Converter={StaticResource MucBrush}}"
                            Visibility="{Binding ThongBaoKhoThe, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding ThongBaoKhoThe}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{Binding MucKhoThe, Converter={StaticResource MucBrush}}" />
                    </Border>

                    <Border Margin="0,6,0,0" Padding="10,6" BorderThickness="4,0,0,0" CornerRadius="2"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{Binding MucThe, Converter={StaticResource MucBrush}}"
                            Visibility="{Binding ThongBaoThe, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding ThongBaoThe}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{Binding MucThe, Converter={StaticResource MucBrush}}" />
                    </Border>

                    <!-- Khung thông tin vé tháng -->
                    <Border Margin="0,8,0,0" Padding="12" CornerRadius="6" BorderThickness="2"
                            BorderBrush="{Binding MucKhopXe, Converter={StaticResource MucBrush}}"
                            Visibility="{Binding VeThang, Converter={StaticResource NullToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Chủ thẻ: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding VeThang.TenKH}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="MSSV/Mã CB: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="3" Text="{Binding VeThang.MaDinhDanh}" />
                            <TextBlock Grid.Row="1" Text="Biển số ĐK: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VeThang.BienSo}" FontWeight="Bold" FontSize="16" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Loại xe: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding VeThang.TenLoai}" />
                            <TextBlock Grid.Row="2" Text="Hết hạn: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VeThang.NgayHetHan, StringFormat=dd/MM/yyyy}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Trạng thái: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding VeThang.TrangThai}"
                                       Foreground="{Binding VeThang.TrangThai, Converter={StaticResource TrangThaiBrush}}" />
                            <TextBlock Grid.Row="3" Grid.ColumnSpan="4" Margin="0,6,0,0" FontWeight="Bold" TextWrapping="Wrap"
                                       Text="{Binding ThongBaoKhopXe}" Foreground="{Binding MucKhopXe, Converter={StaticResource MucBrush}}" />
                        </Grid>
                    </Border>

                    <!-- Bảng giá vé lượt -->
                    <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            Visibility="{Binding BangGia, Converter={StaticResource NullToVisibility}}">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="Bảng giá vé lượt:" FontWeight="SemiBold" />
                            <Run Text="gửi ngày" /> <Run Text="{Binding BangGia.GiaGuiNgay, Mode=OneWay, Converter={StaticResource Money}}" FontWeight="SemiBold" />
                            <Run Text="– gửi đêm (qua 23:00)" /> <Run Text="{Binding BangGia.GiaGuiDem, Mode=OneWay, Converter={StaticResource Money}}" FontWeight="SemiBold" />
                            <Run Text="/đêm" />
                        </TextBlock>
                    </Border>

                    <TextBlock Text="Ghi chú (bắt buộc nếu không có ảnh, ví dụ &quot;Camera lỗi&quot;)" Style="{StaticResource NhanO}" />
                    <ui:TextBox Text="{Binding GhiChu, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ghi chú" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Height="48" HorizontalAlignment="Stretch" Appearance="Primary" FontSize="16"
                                   Content="Tạo lượt gửi &amp; Mở barrier   [F5]" Icon="{ui:SymbolIcon ArrowImport24}"
                                   Command="{Binding TaoLuotGuiCommand}" />
                        <ui:Button Grid.Column="2" Height="48" Content="Làm mới [Esc]" Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding LamMoiCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 10 lượt vào gần nhất -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="10 lượt vào gần nhất" Style="{StaticResource TieuDeKhoi}" />
                            <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Tải lại" Icon="{ui:SymbolIcon ArrowSync24}"
                                       Command="{Binding TaiLaiCommand}" />
                        </DockPanel>
                        <DataGrid Style="{StaticResource LuoiChiDoc}" ItemsSource="{Binding LuotGanDay}" MaxHeight="360">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã vé" Binding="{Binding MaVe}" />
                                <DataGridTextColumn Header="Giờ vào" Binding="{Binding ThoiGianVao, StringFormat=dd/MM/yyyy HH:mm}" />
                                <DataGridTextColumn Header="Biển số" Binding="{Binding BienSo}" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Loại xe" Binding="{Binding TenLoai}" />
                                <DataGridTextColumn Header="Thẻ" Binding="{Binding MaThe}" />
                                <DataGridTextColumn Header="Khu" Binding="{Binding MaKhuVuc}" />
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Chỗ trống theo khu vực" Style="{StaticResource TieuDeKhoi}" />
                        <ItemsControl ItemsSource="{Binding KhuVucs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <TextBlock>
                                                <Run Text="{Binding MaKhuVuc, Mode=OneWay}" FontWeight="Bold" />
                                                <Run Text="{Binding TenKhuVuc, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock>
                                                <Run Text="Còn trống:" />
                                                <Run Text="{Binding ChoTrong, Mode=OneWay}" FontWeight="Bold" FontSize="16" />
                                                <Run Text="/" /><Run Text="{Binding SucChua, Mode=OneWay}" />
                                                <Run Text=" – " /><Run Text="{Binding TrangThaiKhuVuc, Mode=OneWay}"
                                                    Foreground="{Binding TrangThaiKhuVuc, Converter={StaticResource TrangThaiBrush}}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
