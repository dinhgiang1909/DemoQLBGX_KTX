<ui:FluentWindow x:Class="QLBGX.Views.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Đăng nhập - Quản lý bãi giữ xe KTX"
                 Width="420" Height="600"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 FocusManager.FocusedElement="{Binding ElementName=TxtTaiKhoan}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Đăng nhập" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="40,8,40,24" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="VehicleBicycle24" FontSize="56" HorizontalAlignment="Center"
                           Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold"
                       Text="Quản lý bãi giữ xe KTX" />
            <TextBlock Margin="0,4,0,24" HorizontalAlignment="Center"
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                       Text="Đăng nhập để bắt đầu ca làm việc" />

            <TextBlock Text="Tài khoản" Margin="0,0,0,4" />
            <ui:TextBox x:Name="TxtTaiKhoan" PlaceholderText="Nhập tài khoản"
                        Icon="{ui:SymbolIcon Person24}"
                        Text="{Binding TaiKhoan, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Mật khẩu" Margin="0,12,0,4" />
            <ui:PasswordBox PlaceholderText="Nhập mật khẩu"
                            Icon="{ui:SymbolIcon Password24}"
                            Password="{Binding MatKhau, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ui:InfoBar Margin="0,16,0,0" Severity="Error" IsClosable="False" Title="Không đăng nhập được"
                        Message="{Binding ThongBaoLoi}"
                        IsOpen="{Binding ThongBaoLoi, Converter={StaticResource HasText}}"
                        Visibility="{Binding ThongBaoLoi, Converter={StaticResource NullToVisibility}}" />

            <Grid Margin="0,20,0,0">
                <ui:Button HorizontalAlignment="Stretch" Appearance="Primary" IsDefault="True"
                           Height="40" Content="Đăng nhập"
                           Icon="{ui:SymbolIcon ArrowEnter20}"
                           Command="{Binding DangNhapCommand}" />
                <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" HorizontalAlignment="Right"
                                 Margin="0,0,12,0"
                                 Visibility="{Binding DangXuLy, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
