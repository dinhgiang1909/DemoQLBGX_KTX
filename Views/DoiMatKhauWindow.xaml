<ui:FluentWindow x:Class="QLBGX.Views.DoiMatKhauWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Đổi mật khẩu"
                 Width="400" Height="470"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 FocusManager.FocusedElement="{Binding ElementName=TxtMatKhauCu}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Đổi mật khẩu" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="32,8,32,24">
            <TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                <Run Text="Tài khoản:" />
                <Run Text="{Binding TaiKhoan, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>

            <TextBlock Text="Mật khẩu cũ" Margin="0,16,0,4" />
            <ui:PasswordBox x:Name="TxtMatKhauCu"
                            Password="{Binding MatKhauCu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Mật khẩu mới (tối thiểu 6 ký tự, không dấu)" Margin="0,12,0,4" />
            <ui:PasswordBox Password="{Binding MatKhauMoi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Nhập lại mật khẩu mới" Margin="0,12,0,4" />
            <ui:PasswordBox Password="{Binding XacNhanMatKhau, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ui:InfoBar Margin="0,16,0,0" Severity="Error" IsClosable="False" Title="Lỗi"
                        Message="{Binding ThongBaoLoi}"
                        IsOpen="{Binding ThongBaoLoi, Converter={StaticResource HasText}}"
                        Visibility="{Binding ThongBaoLoi, Converter={StaticResource NullToVisibility}}" />

            <StackPanel Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0"
                                 Visibility="{Binding DangXuLy, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Content="Hủy" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
                <ui:Button Content="Đổi mật khẩu" Appearance="Primary" IsDefault="True" MinWidth="120"
                           Command="{Binding DoiMatKhauCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
